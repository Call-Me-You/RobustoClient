<robusta:RobustaWindow xmlns="https://spacestation14.io"
                       xmlns:robusta="clr-namespace:RobustoClient.UI.Controls"
                       xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                       MinSize="750 450"
                       SetSize="750 450">
	<BoxContainer Orientation="Horizontal" SeparationOverride="0">
		<!-- Sidebar -->
		<PanelContainer MinWidth="180">
			<PanelContainer.PanelOverride>
				<graphics:StyleBoxFlat BackgroundColor="#12141C" BorderThickness="0 0 1 0" BorderColor="#1E212B"/>
			</PanelContainer.PanelOverride>
			<BoxContainer Orientation="Vertical" Margin="10 20" SeparationOverride="10">
				<Button Text="COMBAT" Name="TabCombat" HorizontalAlignment="Stretch" />
				<Button Text="VISUALS" Name="TabVisuals" HorizontalAlignment="Stretch" />
				<Button Text="UTILITY" Name="TabUtility" HorizontalAlignment="Stretch" />
				<Button Text="BINDS" Name="TabBinds" HorizontalAlignment="Stretch" />

				<Control VerticalExpand="True" />

				<!-- Sidebar Footer -->
				<BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="5 0">
					<BoxContainer Orientation="Horizontal" SeparationOverride="6">
						<PanelContainer MinWidth="8" MinHeight="8" VerticalAlignment="Center">
							<PanelContainer.PanelOverride>
								<graphics:StyleBoxFlat BackgroundColor="#40ff40" />
							</PanelContainer.PanelOverride>
						</PanelContainer>
						<Label Text="Status: Active" FontColorOverride="#6E7681" />
					</BoxContainer>
					<Label Text="Version: 2.1.0" FontColorOverride="#4E555F" />
				</BoxContainer>

				<Button Text="DISCORD" Name="Discord" HorizontalAlignment="Stretch" Margin="0 5 0 0" Visible="False" />
			</BoxContainer>
		</PanelContainer>

		<!-- Main Content -->
		<BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="20" SeparationOverride="15">
			<ScrollContainer VerticalExpand="True">
				<BoxContainer Orientation="Vertical" Name="ContentContainer" SeparationOverride="12" HorizontalExpand="True">

					<!-- Combat Section -->
					<BoxContainer Orientation="Vertical" Name="CombatSection" SeparationOverride="8">
						<Label Text="COMBAT" FontColorOverride="#6E7681" Margin="0 0 0 5"/>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="Ranged Aimbot" Name="Ranged" HorizontalExpand="True" />
							<Button ToggleMode="True" Text="Aim Prediction" Name="PredictionToggle" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="Melee Aimbot" Name="Melee" HorizontalExpand="True" />
							<Button ToggleMode="True" Text="Melee Triggerbot" Name="MeleeTrigger" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="Throw Aimbot" Name="ThrowAim" HorizontalExpand="True" />
							<Button ToggleMode="True" Text="No Recoil" Name="NoRecoil" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="AutoSpin" Name="AutoSpin" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10" Margin="0 5 0 0">
							<Label Text="FOV (px):" FontColorOverride="#6E7681" VerticalAlignment="Center" />
							<LineEdit Name="AimFovInput" MinWidth="60" HorizontalExpand="True" />
							<Label Text="Lock Dist (m):" FontColorOverride="#6E7681" VerticalAlignment="Center" />
							<LineEdit Name="MaxLockInput" MinWidth="60" HorizontalExpand="True" />
							<Label Text="Spin (°/s):" FontColorOverride="#6E7681" VerticalAlignment="Center" />
							<LineEdit Name="SpinSpeedInput" MinWidth="60" HorizontalExpand="True" />
						</BoxContainer>
					</BoxContainer>

					<!-- Visuals Section -->
					<BoxContainer Orientation="Vertical" Name="VisualsSection" SeparationOverride="8">
						<Label Text="VISUALS" FontColorOverride="#6E7681" Margin="0 10 0 5"/>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="ESP (Name Tags)" Name="EspBtn" HorizontalExpand="True" />
							<Button Text="Reload ESP Config" Name="ReloadEspBtn" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="Fullbright" Name="FullbrightBtn" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="Fov Disabler" Name="DOD" HorizontalExpand="True" />
							<Button ToggleMode="True" Text="Overlays Disabler" Name="OverlaysDisable" HorizontalExpand="True" />
						</BoxContainer>
					</BoxContainer>

					<!-- Utility Section -->
					<BoxContainer Orientation="Vertical" Name="UtilitySection" SeparationOverride="8">
						<Label Text="UTILITY" FontColorOverride="#6E7681" Margin="0 10 0 5"/>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button ToggleMode="True" Text="AntiSlip" Name="AntiSlip" HorizontalExpand="True" />
							<Button ToggleMode="True" Text="Syndicate Detector" Name="SyndicateDetector" HorizontalExpand="True" />
						</BoxContainer>

						<Label Text="Ping Compensation" FontColorOverride="#6E7681" Margin="0 5 0 0"/>
						<BoxContainer Orientation="Horizontal" SeparationOverride="5">
							<Button Text="Local" Name="PingLocal" HorizontalExpand="True" />
							<Button Text="Stable" Name="PingStable" HorizontalExpand="True" />
							<Button Text="Laggy" Name="PingLaggy" HorizontalExpand="True" />
							<Button Text="Auto" Name="PingAuto" HorizontalExpand="True" />
						</BoxContainer>

						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button Text="Open Station Map" Name="OpenMapBtn" HorizontalExpand="True" />
							<Button Text="Open Tactical Radar" Name="OpenTacticalRadarBtn" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Button Text="Stop Construction" Name="StopConstructBtn" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="5">
							<LineEdit Name="BlueprintExportNameInput" PlaceHolder="Blueprint name..." HorizontalExpand="True" MinWidth="160"/>
							<Button Text="Save Area (2 Clicks)" Name="ExportBlueprintBtn" />
							<Button Text="Reload Blueprints" Name="ReloadBlueprintsBtn" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="5" Margin="0 10 0 0">
							<LineEdit Name="ItemSearchInput" PlaceHolder="Item Search..." HorizontalExpand="True" MinWidth="200"/>
							<Button ToggleMode="True" Text="Search" Name="ItemSearchBtn" />
						</BoxContainer>
					</BoxContainer>

					<!-- Binds Section -->
					<BoxContainer Orientation="Vertical" Name="BindsSection" SeparationOverride="8">
						<Label Text="ROBUSTA KEYBINDS" FontColorOverride="#6E7681" Margin="0 10 0 5"/>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Label Text="Auto-Build Key:" FontColorOverride="#CDD6F4" MinWidth="150" VerticalAlignment="Center" />
							<LineEdit Name="BindBuildInput" Text="Period" MinWidth="80" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Label Text="Auto-Deconstruct Key:" FontColorOverride="#CDD6F4" MinWidth="150" VerticalAlignment="Center" />
							<LineEdit Name="BindDeconstructInput" Text="Comma" MinWidth="80" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10">
							<Label Text="Target Lock Key:" FontColorOverride="#CDD6F4" MinWidth="150" VerticalAlignment="Center" />
							<LineEdit Name="BindTargetLockInput" Text="Space" MinWidth="80" HorizontalExpand="True" />
						</BoxContainer>
						<BoxContainer Orientation="Horizontal" SeparationOverride="10" Margin="0 6 0 0">
							<Button Text="Apply &amp; Save Binds" Name="ApplyBindsBtn" HorizontalExpand="True" />
						</BoxContainer>
						<Label Name="BindStatusLabel" Text="" HorizontalAlignment="Center" />

						<Label Text="CONSOLE BINDABLE COMMANDS (bind &lt;Key&gt; command &quot;&lt;cmd&gt;&quot;)" FontColorOverride="#6E7681" Margin="0 15 0 5"/>
						<BoxContainer Orientation="Vertical" SeparationOverride="4">
							<Label Text="• robusta.auto_construct  — Auto-build (tap) / decon (hold/2x)" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.auto_construct build  — Force build" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.auto_construct decon  — Force deconstruct" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.auto_construct stop  — Stop active job" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.auto_deconstruct  — Immediate deconstruct" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.autoreload  — Trigger smart reload macro" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.view_inv  — View inventory of target/cursor" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.toggle_menu  — Open/close cheat menu (Default: F4)" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.auto_zoom.toggle  — Toggle forced zoom" FontColorOverride="#A6ADC8" />
							<Label Text="• robusta.spin.set_enabled &lt;bool&gt;  — Toggle spinbot" FontColorOverride="#A6ADC8" />
							<Label Text="• autochem stop  — Abort automated brewing" FontColorOverride="#A6ADC8" />
						</BoxContainer>
					</BoxContainer>

				</BoxContainer>
			</ScrollContainer>
		</BoxContainer>
	</BoxContainer>
</robusta:RobustaWindow>